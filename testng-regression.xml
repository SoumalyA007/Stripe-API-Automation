<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" verbose="2">
    <listeners>
        <listener class-name="listeners.SuiteCleanupListener"/>
    </listeners>
    <test name="All Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CustomerTests"/>
            <class name="tests.AccountTests"/>
            <class name="tests.ConnectedAccountsTest"/>
            <class name="tests.PaymentMethodTests"/>
            <class name="tests.PaymentIntentTests"/>
            <class name="tests.RefundTests"/>
            <class name="tests.WebhookEventTests"/>
            <class name="tests.SetupIntentTests"/>
            <class name="tests.SubscriptionTests"/>
            <class name="tests.TransferTests"/>
            <class name="tests.PayoutsTest"/>
            <class name="tests.RadarTest"/>
            <class name="tests.DisputesTest"/>
        </classes>
    </test>
</suite>
