<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Idempotency Test Suite" verbose="2">
    <listeners>
        <listener class-name="listeners.SuiteCleanupListener"/>
    </listeners>
    <test name="Idempotency Tests">
        <groups>
            <run>
                <include name="idempotent_test"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CustomerTests"/>
            <class name="tests.PaymentIntentTests"/>
            <class name="tests.RefundTests"/>
            <class name="tests.SetupIntentTests"/>
            <class name="tests.TransferTests"/>
            <class name="tests.PayoutsTest"/>
            <class name="tests.DisputesTest"/>
            <class name="tests.InvoicesTest"/>
        </classes>
    </test>
</suite>
