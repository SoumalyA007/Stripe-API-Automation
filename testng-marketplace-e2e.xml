<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Marketplace E2E Suite" verbose="2">
    <test name="Marketplace End-to-End Flow"
          preserve-order="true"
          thread-count="1">
        <groups>
            <run>
                <include name="marketplace_e2e"/>
            </run>
        </groups>
        <classes>
            <!-- Step 1: Create Customer -->
            <class name="tests.CustomerTests"/>
            <!-- Step 2 + 3: Create & Attach Payment Method -->
            <class name="tests.PaymentMethodTests"/>
            <!-- Step 4: Create SetupIntent  |  Step 7: Retrieve Charge (TC_15) -->
            <class name="tests.SetupIntentTests"/>
            <!-- Step 5 + 6: Create & Confirm Payment Intent -->
            <class name="tests.PaymentIntentTests"/>
            <!-- Step 8: Transfer Funds -->
            <class name="tests.TransferTests"/>
            <!-- Step 9: Create Payout -->
            <class name="tests.PayoutsTest"/>
            <!-- Step 10: Refund -->
            <class name="tests.RefundTests"/>
            <!-- Step 11: Verify Webhooks -->
            <class name="tests.WebhookEventTests"/>
        </classes>
    </test>
</suite>
