<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Saved Card E2E Suite" verbose="2">
    <listeners>
        <listener class-name="listeners.SuiteCleanupListener"/>
    </listeners>
    <test name="Saved Card / Future Payments Flow" preserve-order="true" thread-count="1">
        <groups>
            <run>
                <include name="saved_card_e2e"/>
            </run>
        </groups>
        <classes>
            <!-- Step 1: Create Customer -->
            <class name="tests.CustomerTests"/>
            <!-- Step 2 + 3: Create & Attach Payment Method -->
            <class name="tests.PaymentMethodTests"/>
            <!-- Step 4: Create SetupIntent, Confirm, Retrieve & Off-Session Payment -->
            <class name="tests.SetupIntentTests"/>
        </classes>
    </test>
</suite>
