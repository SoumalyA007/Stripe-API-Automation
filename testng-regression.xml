<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite" verbose="2" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="listeners.SuiteCleanupListener"/>
    </listeners>

    <!-- Group 1: Customer API -->
    <test name="Customer Tests">
        <groups><run><include name="regression"/></run></groups>
        <classes>
            <class name="tests.CustomerTests"/>
        </classes>
    </test>

    <!-- Group 2: Accounts API (v2) -->
    <test name="Account Tests">
        <groups><run><include name="regression"/></run></groups>
        <classes>
            <class name="tests.AccountTests"/>
